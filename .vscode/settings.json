{
    // === EXISTING PYTHON SETTINGS ===
    "python.terminal.activateEnvironment": false,
    "python.defaultInterpreterPath": "C:\\Users\\mjmat\\AppData\\Local\\Programs\\Python\\Python313\\python.exe",
    "python.terminal.activateEnvInCurrentTerminal": false,
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": [],
    
    // === PERFORMANCE OPTIMIZATIONS ===
    
    // Reduce Python language server overhead
    "python.analysis.autoImportCompletions": false,
    "python.analysis.indexing": false,
    "python.analysis.packageIndexDepths": [
        {"name": "", "depth": 2}
    ],
    "python.analysis.memory.keepLibraryAst": false,
    
    // Exclude virtual environments and archive directories from analysis
    "python.analysis.exclude": [
        "**/venv/**",
        "**/venv312/**",
        "**/homeassistant/**",
        "**/archived_debug_files/**",
        "**/archived_test_dev_files/**",
        "**/archived_test_files_2025_oct26/**"
    ],
    
    // Exclude from file explorer indexing (MAJOR performance boost)
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/venv": true,
        "**/venv312": true,
        "**/homeassistant": true,
        "**/*.egg-info": true,
        "**/archived_debug_files": true,
        "**/archived_test_dev_files": true,
        "**/archived_test_files_2025_oct26": true
    },
    
    // Reduce file watching overhead for your trading files
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/*.pyc": true,
        "**/venv/**": true,
        "**/venv312/**": true,
        "**/homeassistant/**": true,
        "**/build/**": true,
        "**/*.egg-info/**": true,
        "**/archived_debug_files/**": true,
        "**/archived_test_dev_files/**": true,
        "**/archived_test_files_2025_oct26/**": true,
        "**/backup_ticker_list_*.json": true,
        "**/fmp_daily_results_*.csv": true,
        "**/*_backup_*.xlsx": true,
        "**/Bryan Perry Transactions_BACKUP_*.xlsx": true
    },
    
    // Optimize IntelliSense responsiveness
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.parameterHints.enabled": false,
    "editor.wordBasedSuggestions": "off",
    
    // Reduce auto-save frequency
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 3000,
    
    // Optimize search to ignore trading data files
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/venv": true,
        "**/venv312": true,
        "**/homeassistant": true,
        "**/build": true,
        "**/*.egg-info": true,
        "**/archived_debug_files": true,
        "**/archived_test_dev_files": true,
        "**/archived_test_files_2025_oct26": true,
        "**/backup_*": true,
        "**/*_BACKUP_*": true,
        "**/fmp_daily_results_*.csv": true
    },
    
    // Reduce terminal overhead
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.scrollback": 1000,
    
    // Optimize editor rendering
    "editor.renderWhitespace": "none",
    "editor.renderControlCharacters": false,
    "editor.minimap.enabled": false,
    "editor.codeLens": false,
    "editor.lightbulb.enabled": "off",
    
    // Reduce extension overhead
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    
    // Git optimizations
    "git.enabled": true,
    "git.autorefresh": false,
    "git.decorations.enabled": false,
    "git.statusLimit": 5000,
    "claudeCodeChat.permissions.yoloMode": false,
    
    // === EXCEL FILE HANDLING ===
    // Use Excel Viewer extension for Excel files
    "workbench.editorAssociations": {
        "*.xlsx": "gc-excelviewer-excel-editor",
        "*.xls": "gc-excelviewer-excel-editor", 
        "*.xlsm": "gc-excelviewer-excel-editor",
        "*.xlsb": "gc-excelviewer-excel-editor"
    },
    
    // Don't treat Excel files as text files
    "files.associations": {
        "*.xlsx": "",
        "*.xls": "",
        "*.xlsm": "",
        "*.xlsb": ""
    }
}